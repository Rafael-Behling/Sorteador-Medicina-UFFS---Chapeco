<html xmlns:hta="urn:schemas-microsoft-com:hta">
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>CampeANATO - Painel de Grupos</title>
<hta:application
  id="oHTA"
  applicationname="CampeANATOPainel"
  border="thin"
  caption="yes"
  maximizebutton="yes"
  minimizebutton="yes"
  scroll="no"
  showintaskbar="yes"
  windowstate="normal"
  singleinstance="yes"
  contextmenu="no"
  sysmenu="yes"
/>
<style>
* { box-sizing: border-box; }
html, body {
  margin:0; padding:0; background:#0b1220; color:#ffffff;
  font-family:'Segoe UI', Tahoma, sans-serif; overflow:auto;
}
body { padding-bottom:26px; }
#hud { padding:12px 18px; background:rgba(0,0,0,.38); position:relative;
  border-bottom:1px solid rgba(255,255,255,.10); }
#hud .brand { font-size:16px; letter-spacing:2px; font-weight:700; }
#hud .status { font-size:13px; opacity:.8; margin-left:14px; letter-spacing:1px; }
#hud .right { position:absolute; right:14px; top:9px; }
.wrap { max-width:1060px; margin:0 auto; padding:20px; }
.drawctl { text-align:center; margin:2px 0 20px; padding:0 0 18px;
  border-bottom:1px solid rgba(255,255,255,.10); }
.drawctl .btn { margin:4px 5px; }
.timerctl { text-align:center; margin:2px 0 20px; padding:0 0 18px;
  border-bottom:1px solid rgba(255,255,255,.10); }
.timerctl label { opacity:.85; margin-right:8px; letter-spacing:1px; font-size:16px; }
.tdisp { display:inline-block; min-width:80px; margin-left:16px; font-size:34px; font-weight:800;
  color:#ffd34d; vertical-align:middle; text-shadow:0 3px 16px rgba(0,0,0,.6); }
.tdisp.rodando { color:#7cfc9b; }
.tdisp.mudo { opacity:.45; }
.panel { text-align:center; }
.ptitle { font-size:26px; font-weight:800; letter-spacing:3px; margin:6px 0 18px;
  text-shadow:0 4px 22px rgba(0,0,0,.6); }
.setupline { margin:10px 0; font-size:16px; }
.setupline label { opacity:.85; margin-right:8px; letter-spacing:1px; }
.btn { display:inline-block; cursor:pointer; border:none; color:#fff;
  font-family:inherit; font-weight:700; letter-spacing:1px;
  background:linear-gradient(#2a7de1,#0b4ea0); border-radius:10px;
  padding:11px 20px; margin:0 5px; font-size:16px; vertical-align:middle;
  box-shadow:0 6px 18px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.25); }
.btn:hover { background:linear-gradient(#3b8ef0,#0c5cb8); }
.btn.small { font-size:12px; padding:8px 13px; border-radius:8px; }
.btn.ghost { background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.35); box-shadow:none; }
.btn.ghost:hover { background:rgba(255,255,255,.24); }
.btn.green { background:linear-gradient(#2fae5a,#177a38); }
.btn.green:hover { background:linear-gradient(#39c768,#1c8f42); }
.bigbtn { display:inline-block; font-size:20px; padding:14px 44px; border-radius:14px; }
.inp { background:rgba(0,0,0,.45); border:2px solid rgba(255,255,255,.30); color:#fff;
  border-radius:9px; padding:9px 13px; font-size:16px; font-family:inherit; }
.inp:focus { outline:none; border-color:#2a7de1; }
.inp.small { width:90px; text-align:center; }
.gname { width:92%; }
.glista { margin:16px auto; }
.grow { display:table; width:100%; table-layout:fixed;
  background:rgba(255,255,255,.05); border:2px solid rgba(255,255,255,.14);
  border-radius:12px; margin:8px 0; padding:8px 12px; }
.gpos { display:table-cell; width:58px; vertical-align:middle; text-align:center;
  font-size:22px; font-weight:800; color:#9fd0ff; }
.gnome { display:table-cell; vertical-align:middle; text-align:left;
  font-size:20px; padding:0 12px; overflow:hidden; }
.gpts { display:table-cell; width:110px; vertical-align:middle; text-align:right;
  font-size:26px; font-weight:800; color:#ffd34d; padding:0 12px; }
.gctrl { display:table-cell; width:250px; vertical-align:middle; text-align:right; white-space:nowrap; }
.empty { opacity:.7; font-size:16px; padding:22px; }
.r1 { background:linear-gradient(90deg, rgba(255,196,0,.30), rgba(255,255,255,.03)); border-color:rgba(255,196,0,.55); }
.r2 { background:linear-gradient(90deg, rgba(192,192,192,.26), rgba(255,255,255,.03)); border-color:rgba(200,200,200,.5); }
.r3 { background:linear-gradient(90deg, rgba(205,127,50,.26), rgba(255,255,255,.03)); border-color:rgba(205,127,50,.5); }
.tip { font-size:13px; opacity:.7; margin-top:16px; }
#tip { position:fixed; left:50%; bottom:16px; transform:translateX(-50%);
  -ms-transform:translateX(-50%); background:rgba(0,0,0,.7); color:#fff;
  padding:9px 18px; border-radius:22px; font-size:14px; letter-spacing:1px;
  opacity:0; transition:opacity .3s; -ms-transition:opacity .3s; pointer-events:none; }
#tip.show { opacity:1; }
</style>
</head>
<body>

<div id="hud">
  <span class="brand">CAMPEANATO &bull; PAINEL</span>
  <span class="status" id="statusRestam"></span>
  <span class="right">
    <span class="btn small ghost" id="btnSom" title="Ligar/desligar todos os sons">Som: ON</span>
    <span class="btn small ghost" id="btnAbrirSorteador">Abrir projetor</span>
    <span class="btn small ghost" id="btnSair">Sair</span>
  </span>
</div>

<div class="wrap">

  <div class="drawctl">
    <span class="btn bigbtn green" onclick="sortear()">SORTEAR</span>
    <span class="btn ghost" onclick="telaCheia()">Tela cheia (F11)</span>
    <span class="btn ghost" onclick="modoLimpo()">Modo limpo (F10)</span>
    <span class="btn ghost" onclick="resetSorteio()">Reiniciar sorteio</span>
  </div>

  <div class="timerctl">
    <label>Tempo (segundos):</label>
    <input type="text" id="inpTempo" class="inp small" value="30" onchange="syncTempoDisplay()">
    <span class="btn green" id="btnTempo" onclick="toggleTempo()">Iniciar tempo</span>
    <span class="tdisp" id="tempoDisp">30</span>
  </div>

  <div class="panel" id="setupPanel">
    <div class="ptitle">CONFIGURAR GRUPOS</div>
    <div class="setupline">
      <label>Quantidade de grupos:</label>
      <input type="text" id="inpQtd" class="inp small" value="3">
      <span class="btn" onclick="criarGrupos()">Criar</span>
    </div>
    <div class="setupline">
      <label>Nome do grupo:</label>
      <input type="text" id="inpNome" class="inp" placeholder="Ex.: Grupo 1" style="width:260px;">
      <span class="btn" onclick="adicionarGrupo()">Adicionar</span>
    </div>
    <div id="setupLista" class="glista"></div>
    <div class="setupline">
      <span class="btn bigbtn green" onclick="iniciarJogo()">INICIAR JOGO</span>
    </div>
  </div>

  <div class="panel hidden" id="scorePanel">
    <div class="ptitle">RANKING &amp; PONTOS</div>
    <div class="setupline">
      <label>Pontos por acerto:</label>
      <input type="text" id="inpPontos" class="inp small" value="10">
      <span class="btn ghost" onclick="abrirSetup()">Editar grupos</span>
    </div>
    <div class="setupline">
      <span class="btn green" onclick="finalizarJogo()">Finalizar</span>
      <span class="btn ghost" onclick="repetirAnimacao()">Repetir anima&ccedil;&atilde;o</span>
      <span class="btn ghost" onclick="voltarSorteio()">Voltar ao sorteio</span>
      <span class="btn ghost" onclick="novoJogo()">Novo jogo (zerar)</span>
    </div>
    <div id="scoreLista" class="glista"></div>
    <div class="tip">Ao clicar em <b>Finalizar</b>, o p&oacute;dio com suspense aparece na tela do projetor.</div>
  </div>

</div>

<div id="tip"></div>

<script language="JScript">
var fso = new ActiveXObject("Scripting.FileSystemObject");
var base = "C:\\Users\\Rafael\\Documents\\MED";

function deriveBase(){
  try {
    var p = location.href.replace(/^file:\/\/\//i, "").replace(/\//g, "\\");
    p = decodeURIComponent(p);
    if (fso.FileExists(p)) return fso.GetParentFolderName(p);
  } catch (e) {}
  return base;
}

base = deriveBase();

window.onerror = function(msg, url, line){
  try {
    var f = fso.OpenTextFile(base + "\\_erros.log", 8, true);
    f.WriteLine((new Date()) + " | PAINEL | " + msg + " | linha " + line);
    f.Close();
  } catch (e) {}
  return true;
};

var grupos = [];
var nextGid = 1;
var TIEBREAK = null;

function trim(s){ return String(s).replace(/^\s+|\s+$/g, ""); }
function stop(){ try { window.event.cancelBubble = true; } catch (e) {} }

function esc(s){
  return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}
function escAttr(s){
  return String(s).replace(/&/g,"&amp;").replace(/"/g,"&quot;")
                  .replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

/* ---------- Persistência (arquivo compartilhado com a tela pública) ---------- */
function saveGrupos(){
  try {
    var f = fso.CreateTextFile(base + "\\ranking.txt", true);
    for (var i = 0; i < grupos.length; i++)
      f.WriteLine(encodeURIComponent(grupos[i].nome) + "|" + grupos[i].pontos);
    f.Close();
  } catch (e) {}
}

function loadGrupos(){
  grupos = []; nextGid = 1;
  try {
    var fp = base + "\\ranking.txt";
    if (fso.FileExists(fp)){
      var f = fso.OpenTextFile(fp, 1);
      while (!f.AtEndOfStream){
        var l = f.ReadLine();
        l = l.replace(/^\uFEFF/, "");
        if (!l || l.charAt(0) == "#") continue;
        var i = l.lastIndexOf("|");
        if (i < 0) continue;
        var nome = "";
        try { nome = decodeURIComponent(l.substring(0, i)); } catch (e2) { nome = l.substring(0, i); }
        var pts = parseInt(l.substring(i + 1), 10);
        if (isNaN(pts) || pts < 0) pts = 0;
        if (nome.length) grupos.push({ id: nextGid++, nome: nome, pontos: pts });
      }
      f.Close();
    }
  } catch (e) {}
}

function acharGrupo(id){
  for (var i = 0; i < grupos.length; i++) if (grupos[i].id === id) return grupos[i];
  return null;
}

function cmpRanking(a, b){
  if (b.pontos !== a.pontos) return b.pontos - a.pontos;
  if (TIEBREAK) { var r = TIEBREAK(a, b); if (r) return r; }
  return a.id - b.id;
}
function rankingOrdenado(){
  var c = grupos.slice(0);
  c.sort(cmpRanking);
  return c;
}
function comPosicoes(ord){
  var res = [], pos = 1;
  for (var i = 0; i < ord.length; i++){
    if (i > 0 && ord[i].pontos !== ord[i - 1].pontos) pos = i + 1;
    res.push({ g: ord[i], pos: pos });
  }
  return res;
}

function nomeInvalido(nome, ignoreId){
  if (!trim(nome).length) return "O nome do grupo n\u00E3o pode ficar vazio.";
  for (var i = 0; i < grupos.length; i++){
    if (grupos[i].id !== ignoreId && grupos[i].nome.toLowerCase() === trim(nome).toLowerCase())
      return "J\u00E1 existe um grupo com esse nome.";
  }
  return "";
}

/* ---------- Setup ---------- */
function showPanel(which){
  document.getElementById("setupPanel").className = (which == "setup") ? "panel" : "panel hidden";
  document.getElementById("scorePanel").className = (which == "score") ? "panel" : "panel hidden";
}

function renderSetup(){
  var cont = document.getElementById("setupLista");
  var html = "";
  for (var i = 0; i < grupos.length; i++){
    var g = grupos[i];
    html += '<div class="grow">' +
      '<div class="gpos">' + (i + 1) + '</div>' +
      '<div class="gnome"><input type="text" class="inp gname" value="' + escAttr(g.nome) +
        '" onchange="renomearGrupo(' + g.id + ', this.value)"></div>' +
      '<div class="gctrl"><span class="btn small ghost" onclick="removerGrupo(' + g.id + ')">remover</span></div>' +
      '</div>';
  }
  if (!grupos.length) html = '<div class="empty">Nenhum grupo ainda. Defina a quantidade e clique em Criar, ou adicione um por vez.</div>';
  cont.innerHTML = html;
}

function adicionarGrupo(){
  stop();
  var inp = document.getElementById("inpNome");
  var nome = trim(inp.value);
  var err = nomeInvalido(nome, -1);
  if (err){ alert(err); inp.focus(); return; }
  grupos.push({ id: nextGid++, nome: nome, pontos: 0 });
  inp.value = "";
  inp.focus();
  saveGrupos(); renderSetup();
}

function criarGrupos(){
  stop();
  var n = parseInt(trim(document.getElementById("inpQtd").value), 10);
  if (isNaN(n) || n < 1 || n > 30){ alert("Informe uma quantidade entre 1 e 30 grupos."); return; }
  if (grupos.length && !confirm("Isso substitui os grupos atuais. Continuar?")) return;
  grupos = []; nextGid = 1;
  for (var i = 1; i <= n; i++) grupos.push({ id: nextGid++, nome: "Grupo " + i, pontos: 0 });
  saveGrupos(); renderSetup();
}

function removerGrupo(id){
  stop();
  var g = acharGrupo(id); if (!g) return;
  if (!confirm("Remover o grupo \"" + g.nome + "\"?")) return;
  for (var i = 0; i < grupos.length; i++) if (grupos[i].id === id){ grupos.splice(i, 1); break; }
  saveGrupos(); renderSetup(); renderScore();
}

function renomearGrupo(id, valor){
  stop();
  var g = acharGrupo(id); if (!g) return;
  var nome = trim(valor);
  var err = nomeInvalido(nome, id);
  if (err){ alert(err); renderSetup(); return; }
  g.nome = nome;
  saveGrupos(); renderScore();
}

/* ---------- Pontuação ---------- */
function valorPontos(){
  var v = parseInt(trim(document.getElementById("inpPontos").value), 10);
  if (isNaN(v) || v < 0) return -1;
  return v;
}

function renderScore(){
  var ord = comPosicoes(rankingOrdenado());
  var cont = document.getElementById("scoreLista");
  var html = "";
  for (var i = 0; i < ord.length; i++){
    var g = ord[i].g, p = ord[i].pos;
    var cls = "grow" + (p === 1 ? " r1" : (p === 2 ? " r2" : (p === 3 ? " r3" : "")));
    html += '<div class="' + cls + '">' +
      '<div class="gpos">' + p + '\u00BA</div>' +
      '<div class="gnome">' + esc(g.nome) + '</div>' +
      '<div class="gpts">' + g.pontos + '</div>' +
      '<div class="gctrl">' +
        '<span class="btn small" onclick="uiAdd(' + g.id + ')">+</span>' +
        '<span class="btn small ghost" onclick="uiSub(' + g.id + ')">\u2212</span>' +
        '<span class="btn small ghost" onclick="uiDef(' + g.id + ')">definir</span>' +
      '</div></div>';
  }
  if (!ord.length) html = '<div class="empty">Nenhum grupo cadastrado.</div>';
  cont.innerHTML = html;
}

function uiAdd(id){
  stop();
  var v = valorPontos();
  if (v < 0){ alert("Valor de pontos inv\u00E1lido."); return; }
  var g = acharGrupo(id); if (!g) return;
  g.pontos += v;
  saveGrupos(); renderScore();
}
function uiSub(id){
  stop();
  var v = valorPontos();
  if (v < 0){ alert("Valor de pontos inv\u00E1lido."); return; }
  var g = acharGrupo(id); if (!g) return;
  if (g.pontos - v < 0){ alert("A pontua\u00E7\u00E3o n\u00E3o pode ficar negativa."); return; }
  g.pontos -= v;
  saveGrupos(); renderScore();
}
function uiDef(id){
  stop();
  var g = acharGrupo(id); if (!g) return;
  var s = prompt("Corrigir a pontua\u00E7\u00E3o de \"" + g.nome + "\":", "" + g.pontos);
  if (s === null) return;
  var v = parseInt(trim(s), 10);
  if (isNaN(v) || v < 0){ alert("Informe um n\u00FAmero inteiro maior ou igual a 0."); return; }
  g.pontos = v;
  saveGrupos(); renderScore();
}

function abrirSetup(){ stop(); showPanel("setup"); renderSetup(); }

function iniciarJogo(){
  stop();
  if (grupos.length < 1){ alert("Cadastre pelo menos um grupo para iniciar."); return; }
  saveGrupos();
  showPanel("score");
  renderScore();
}

/* ---------- Comandos para a tela pública ---------- */
function sendCmd(cmd){
  try {
    var f = fso.CreateTextFile(base + "\\comando.txt", true);
    f.WriteLine((new Date()).getTime() + "|" + cmd);
    f.Close();
    showTip("Enviado: " + cmd);
  } catch (e) {}
}

function finalizarJogo(){
  stop();
  if (grupos.length < 1){ alert("Cadastre pelo menos um grupo."); return; }
  saveGrupos();
  sendCmd("FINALIZAR");
}
function repetirAnimacao(){ stop(); sendCmd("REVELAR"); }
function voltarSorteio(){ stop(); sendCmd("VOLTAR"); }

function sortear(){ stop(); sendCmd("SORTEAR"); }
function telaCheia(){ stop(); sendCmd("FULLSCREEN"); }
function modoLimpo(){ stop(); sendCmd("CLEAN"); }

function resetSorteio(){
  stop();
  if (!confirm("Reiniciar o sorteio?\nTodas as combina\u00E7\u00F5es voltam a ficar dispon\u00EDveis.")) return;
  sendCmd("RESETSORTEIO");
}

function novoJogo(){
  stop();
  if (!confirm("Zerar a pontua\u00E7\u00E3o de todos os grupos?")) return;
  for (var i = 0; i < grupos.length; i++) grupos[i].pontos = 0;
  saveGrupos(); renderScore(); renderSetup();
  sendCmd("VOLTAR");
}

function abrirSorteador(){
  try {
    var sh = new ActiveXObject("WScript.Shell");
    var exe = sh.ExpandEnvironmentStrings("%SystemRoot%\\System32\\mshta.exe");
    sh.Run('"' + exe + '" "' + base + '\\Sorteador.hta"', 1, false);
  } catch (e) {}
}

/* ---------- Status / heartbeat / posição da janela ---------- */
/* ---------- Cronometro + som da pergunta ---------- */
var somMudo = false;
var timerTick = null;
var timerRestante = 0;
var timerProc = null;

function lerMudo(){
  try {
    var fp = base + "\\_som_mudo.txt";
    if (fso.FileExists(fp)){
      var f = fso.OpenTextFile(fp, 1);
      var l = f.AtEndOfStream ? "" : f.ReadLine();
      f.Close();
      return l.replace(/\s/g, "") == "1";
    }
  } catch (e) {}
  return false;
}

function saveSom(){
  try {
    var f = fso.CreateTextFile(base + "\\_som_mudo.txt", true);
    f.WriteLine(somMudo ? "1" : "0");
    f.Close();
  } catch (e) {}
}

function atualizaBotaoSom(){
  var b = document.getElementById("btnSom");
  if (b){
    b.innerHTML = somMudo ? "Som: OFF" : "Som: ON";
    b.style.opacity = somMudo ? "0.55" : "1";
  }
  var d = document.getElementById("tempoDisp");
  if (d) d.className = "tdisp" + (timerTick ? " rodando" : "") + (somMudo ? " mudo" : "");
}

function setSom(m, gravar){
  somMudo = !!m;
  if (gravar !== false) saveSom();
  atualizaBotaoSom();
}

function tocarTrunc(ms){
  pararPergunta();
  if (lerMudo()) return;
  try {
    var exe = base + "\\playsound.exe";
    var wav = base + "\\SONS\\pergunta_trunc.wav";
    if (!fso.FileExists(exe) || !fso.FileExists(wav)) return;
    var sh = new ActiveXObject("WScript.Shell");
    timerProc = sh.Exec('"' + exe + '" "' + wav + '" ' + ms + ' 1');
  } catch (e) { timerProc = null; }
}

function tocarSino(ms){
  pararPergunta();
  if (lerMudo()) return;
  try {
    var exe = base + "\\playsound.exe";
    var wav = base + "\\SONS\\sino.wav";
    if (!fso.FileExists(exe) || !fso.FileExists(wav)) return;
    var sh = new ActiveXObject("WScript.Shell");
    timerProc = sh.Exec('"' + exe + '" "' + wav + '" ' + ms + ' 0');
  } catch (e) { timerProc = null; }
}

function pararPergunta(){
  try { if (timerProc) timerProc.Terminate(); } catch (e) {}
  timerProc = null;
}

function atualizaTempo(){
  var d = document.getElementById("tempoDisp");
  if (!d) return;
  d.innerHTML = timerRestante;
  d.className = "tdisp" + (timerTick ? " rodando" : "") + (somMudo ? " mudo" : "");
}

function syncTempoDisplay(){
  if (timerTick) return;
  var s = parseInt(trim(document.getElementById("inpTempo").value), 10);
  if (!isNaN(s) && s >= 0 && s <= 3600){ timerRestante = s; atualizaTempo(); }
}

function iniciarTempo(){
  stop();
  if (timerTick) return;
  var s = parseInt(trim(document.getElementById("inpTempo").value), 10);
  if (isNaN(s) || s < 1 || s > 3600){ alert("Informe um tempo em segundos (1 a 3600)."); return; }
  timerRestante = s;
  var btn = document.getElementById("btnTempo");
  if (btn){ btn.innerHTML = "Parar"; btn.className = "btn"; }
  atualizaTempo();
  if (s > 2) {
    tocarTrunc((s - 2) * 1000);
  } else {
    tocarSino(s * 1000);
  }
  timerTick = setInterval(function(){
    timerRestante--;
    if (timerRestante < 0) timerRestante = 0;
    if (timerTick && timerRestante == 2) {
      pararPergunta();
      tocarSino(2000);
    }
    atualizaTempo();
    if (timerRestante <= 0) pararTempo();
  }, 1000);
}

function pararTempo(){
  if (timerTick){ clearInterval(timerTick); timerTick = null; }
  pararPergunta();
  var btn = document.getElementById("btnTempo");
  if (btn){ btn.innerHTML = "Iniciar tempo"; btn.className = "btn green"; }
  atualizaTempo();
}

function toggleTempo(){
  stop();
  if (timerTick) pararTempo(); else iniciarTempo();
}

var tipTimer = null;
function showTip(t){
  var el = document.getElementById("tip");
  el.innerHTML = t; el.className = "show";
  if (tipTimer) clearTimeout(tipTimer);
  tipTimer = setTimeout(function(){ el.className = ""; }, 2000);
}

function findFolder(names){
  for (var i = 0; i < names.length; i++){
    var p = base + "\\" + names[i];
    if (fso.FolderExists(p)) return p;
  }
  return base + "\\" + names[0];
}
function countImages(fp){
  var n = 0;
  try {
    if (fso.FolderExists(fp)){
      var e = new Enumerator(fso.GetFolder(fp).Files);
      for (; !e.atEnd(); e.moveNext())
        if (/\.(png|jpg|jpeg|gif|bmp|webp)$/i.test(e.item().Name)) n++;
    }
  } catch (e2) {}
  return n;
}
function updateStatus(){
  try {
    var total = countImages(findFolder(["TOPICOS","TIPOS","TOPIC","TEMAS"])) *
                countImages(findFolder(["NUMEROS","NUMERO","N\u00DAMEROS"]));
    var dr = 0;
    var fp = base + "\\progresso.txt";
    if (fso.FileExists(fp)){
      var f = fso.OpenTextFile(fp, 1);
      while (!f.AtEndOfStream){ if (trim(f.ReadLine()).length) dr++; }
      f.Close();
    }
    var rem = total - dr; if (rem < 0) rem = 0;
    document.getElementById("statusRestam").innerHTML =
      "Restam " + rem + " de " + total + " combina\u00E7\u00F5es";
  } catch (e) {}
}

function heartbeat(){
  try {
    var f = fso.CreateTextFile(base + "\\_painel.lock", true);
    f.WriteLine((new Date()).getTime());
    f.Close();
  } catch (e) {}
}

function loadPos(){
  try {
    var fp = base + "\\_pos_painel.txt";
    if (fso.FileExists(fp)){
      var f = fso.OpenTextFile(fp, 1);
      var l = f.AtEndOfStream ? "" : f.ReadLine();
      f.Close();
      var m = l.match(/(-?\d+)\s*,\s*(-?\d+)\s*,\s*(\d+)\s*,\s*(\d+)/);
      if (m) return { x:parseInt(m[1],10), y:parseInt(m[2],10), w:parseInt(m[3],10), h:parseInt(m[4],10) };
    }
  } catch (e) {}
  return null;
}
function savePos(){
  try {
    var f = fso.CreateTextFile(base + "\\_pos_painel.txt", true);
    f.WriteLine(window.screenLeft + "," + window.screenTop + "," + window.outerWidth + "," + window.outerHeight);
    f.Close();
  } catch (e) {}
}

function init(){
  base = deriveBase();

  var p = loadPos();
  if (p && p.w > 300 && p.h > 250){
    try { window.moveTo(p.x, p.y); window.resizeTo(p.w, p.h); } catch (e) {}
  } else {
    try {
      var w = 1020, h = 780;
      window.moveTo(Math.round((screen.availWidth - w) / 2), 30);
      window.resizeTo(w, h);
    } catch (e) {}
  }

  loadGrupos();
  if (grupos.length == 0){ showPanel("setup"); renderSetup(); }
  else { showPanel("score"); renderScore(); }

  document.getElementById("hud").onclick = function(){ stop(); };
  document.getElementById("btnSair").onclick = function(){ stop(); window.close(); };
  document.getElementById("btnAbrirSorteador").onclick = function(){ stop(); abrirSorteador(); };
  document.getElementById("btnSom").onclick = function(){ stop(); setSom(!lerMudo()); };

  setSom(lerMudo(), false);
  syncTempoDisplay();
  setInterval(function(){
    var m = lerMudo();
    if (m !== somMudo) setSom(m, false);
  }, 2000);

  document.onkeydown = function(){
    var e = window.event;
    var k = e.keyCode;
    var t = e.srcElement || e.target;
    var tag = (t && t.tagName) ? t.tagName : "";
    if (tag == "INPUT"){
      if (k == 13){
        if (t.id == "inpNome"){ adicionarGrupo(); return false; }
        if (t.id == "inpQtd"){ criarGrupos(); return false; }
      }
      return true;
    }
    if (k == 32){ sortear(); return false; }
    return true;
  };

  heartbeat();
  setInterval(heartbeat, 1500);
  updateStatus();
  setInterval(updateStatus, 2000);
  setInterval(savePos, 2500);
}

init();
</script>
</body>
</html>
